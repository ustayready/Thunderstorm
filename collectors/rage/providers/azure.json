  "facts": [
    {
      "kind": "role_assignment",
      "collect": {
        "operation": "Microsoft.Authorization/roleAssignments (list)",
        "over": "azure:subscription, azure:resourcegroup, any resource scope",
        "scope": "subscription"
      },
      "backs": [
        "HasRole",
        "HasPermission"
      ],
      "required_permissions": [
        "Microsoft.Authorization/roleAssignments/read"
      ],
      "note": "role assignments + role definitions evaluate into effective permissions backing the capability edges"
    },
    {
      "kind": "role_definition",
      "collect": {
        "operation": "Microsoft.Authorization/roleDefinitions (list)",
        "over": "azure:subscription",
        "scope": "subscription"
      },
      "backs": [
        "HasPermission"
      ],
      "required_permissions": [
        "Microsoft.Authorization/roleDefinitions/read"
      ]
    },
    {
      "kind": "deny_assignment",
      "collect": {
        "operation": "Microsoft.Authorization/denyAssignments (list)",
        "over": "azure:subscription",
        "scope": "subscription"
      },
      "backs": [],
      "required_permissions": [
        "Microsoft.Authorization/denyAssignments/read"
      ],
      "note": "a guardrail: deny assignments block effective permissions (edge state BLOCKED)"
    },
    {
      "kind": "mg_hierarchy",
      "collect": {
        "operation": "Microsoft.Management/managementGroups (list + descendants)",
        "over": "azure:managementgroup",
        "scope": "tenant"
      },
      "backs": [
        "Contains",
        "CanEnterSubscription",
        "CanEnterTenant"
      ],
      "required_permissions": [
        "Microsoft.Management/managementGroups/read"
      ]
    },
    {
      "kind": "entra_role_assignment",
      "collect": {
        "operation": "msgraph roleManagement.directory.roleAssignments + roleEligibilityScheduleInstances",
        "over": "azure:entra:user, azure:entra:serviceprincipal, azure:entra:group",
        "scope": "tenant"
      },
      "backs": [
        "HasRole",
        "CanGrantPermission"
      ],
      "required_permissions": [
        "RoleManagement.Read.Directory"
      ]
    },
    {
      "kind": "entra_owner",
      "collect": {
        "operation": "msgraph owners (application/servicePrincipal/group owners)",
        "over": "azure:entra:serviceprincipal, azure:entra:group",
        "scope": "tenant"
      },
      "backs": [
        "CanControl",
        "CanCreateCredentialFor"
      ],
      "required_permissions": [
        "Application.Read.All",
        "Directory.Read.All"
      ]
    },
    {
      "kind": "entra_app_role",
      "collect": {
        "operation": "msgraph appRoleAssignments / oauth2PermissionGrants",
        "over": "azure:entra:serviceprincipal",
        "scope": "tenant"
      },
      "backs": [
        "HasPermission",
        "CanGrantPermission"
      ],
      "required_permissions": [
        "Application.Read.All",
        "Directory.Read.All"
      ]
    },
    {
      "kind": "membership",
      "collect": {
        "operation": "msgraph group members (transitiveMembers)",
        "over": "azure:entra:group",
        "scope": "tenant"
      },
      "backs": [
        "MemberOf"
      ],
      "required_permissions": [
        "GroupMember.Read.All"
      ]
    },
    {
      "kind": "resource_policy",
      "collect": {
        "operation": "Key Vault access policies / storage account public access / resource-scope role assignments",
        "over": "azure:keyvault:vault, azure:storage:account",
        "scope": "subscription"
      },
      "backs": [
        "HasPolicy",
        "CanReadSecret",
        "CanDecrypt",
        "ExposedToInternet"
      ],
      "required_permissions": [
        "Microsoft.KeyVault/vaults/read",
        "Microsoft.Storage/storageAccounts/read"
      ]
    }
  ],
