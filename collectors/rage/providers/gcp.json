  "facts": [
    {
      "kind": "iam_binding",
      "collect": {
        "operation": "getIamPolicy (resourcemanager.{projects,folders,organizations}.getIamPolicy)",
        "over": "gcp:resourcemanager:project, gcp:resourcemanager:folder, gcp:resourcemanager:organization",
        "scope": "project"
      },
      "backs": [
        "HasRole",
        "HasPermission",
        "CanImpersonate"
      ],
      "required_permissions": [
        "resourcemanager.projects.getIamPolicy",
        "resourcemanager.folders.getIamPolicy",
        "resourcemanager.organizations.getIamPolicy"
      ],
      "note": "IAM bindings evaluate into effective permissions backing the capability edges"
    },
    {
      "kind": "resource_policy",
      "collect": {
        "operation": "<service>.getIamPolicy on the resource",
        "over": "gcp:storage:bucket, gcp:cloudkms:key-ring, gcp:secretmanager:secret, gcp:iam:service-account",
        "scope": "project"
      },
      "backs": [
        "HasPolicy",
        "CanReadData",
        "CanDecrypt",
        "CanReadSecret",
        "CanImpersonate"
      ],
      "required_permissions": [
        "storage.buckets.getIamPolicy",
        "cloudkms.cryptoKeys.getIamPolicy",
        "secretmanager.secrets.getIamPolicy",
        "iam.serviceAccounts.getIamPolicy"
      ]
    },
    {
      "kind": "public",
      "collect": {
        "operation": "allUsers / allAuthenticatedUsers bindings in a getIamPolicy result",
        "over": "gcp:storage:bucket, gcp:run:service",
        "scope": "project"
      },
      "backs": [
        "ExposedToInternet",
        "ExposedToTenant"
      ],
      "required_permissions": [
        "storage.buckets.getIamPolicy",
        "run.services.getIamPolicy"
      ]
    },
    {
      "kind": "membership",
      "collect": {
        "operation": "cloudidentity.groups.memberships.list",
        "over": "gcp:cloudidentity:group",
        "scope": "global"
      },
      "backs": [
        "MemberOf"
      ],
      "required_permissions": [
        "cloudidentity.groups.memberships.list"
      ]
    },
    {
      "kind": "workload_identity",
      "collect": {
        "operation": "iam.serviceAccounts.getIamPolicy (WIF pool bindings) / getOpenIdToken",
        "over": "gcp:iam:workload-identity-pool, gcp:iam:service-account",
        "scope": "project"
      },
      "backs": [
        "CanFederateAs",
        "FederatesTo"
      ],
      "required_permissions": [
        "iam.workloadIdentityPools.get",
        "iam.serviceAccounts.getIamPolicy"
      ]
    }
  ],
