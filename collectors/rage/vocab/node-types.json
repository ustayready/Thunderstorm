{
  "$comment": "RAGE node-type registry \u2014 the provider-independent vocabulary. OPEN: an unknown provider resource maps to the nearest generic type and keeps its native string verbatim (provider_type); if nothing fits, use the class-level Generic* fallback. A generic type names a SECURITY ROLE, not a product.",
  "spec_version": "0.1",
  "classes": {
    "Identity": {
      "doc": "Any principal that can hold permissions or be authenticated as."
    },
    "AdministrativeBoundary": {
      "doc": "Containers that scope permissions, policy inheritance, and control."
    },
    "Compute": {
      "doc": "Resources that execute attacker-influenceable code and usually run AS an identity."
    },
    "Storage": {
      "doc": "Durable data-at-rest stores \u2014 objects, files, blocks, snapshots, backups, and artifact/image repositories an attacker reads, writes, or exfiltrates."
    },
    "Data": {
      "doc": "Structured data services \u2014 relational/NoSQL databases, warehouses, caches, search and analytics stores holding queryable data."
    },
    "Messaging": {
      "doc": "Integration primitives that can trigger execution or carry credentials."
    },
    "Secret": {
      "doc": "Credential and cryptographic material \u2014 terminal targets and pivots."
    },
    "Network": {
      "doc": "Connectivity and reachability primitives (networks, subnets, firewalls, routes, endpoints) that gate whether one resource can reach another."
    },
    "Policy": {
      "doc": "Authorization & governance artifacts. Nodes so their mutation is an edge target."
    },
    "ManagementService": {
      "doc": "Control-plane & security services whose abuse enables execution, persistence, or evasion."
    }
  },
  "node_types": {
    "HumanIdentity": {
      "class": "Identity",
      "doc": "Interactive user backed by a human (console/SSO login)."
    },
    "MachineIdentity": {
      "class": "Identity",
      "doc": "Non-human principal an attacker can assume/impersonate (role/SA/MI)."
    },
    "WorkloadIdentity": {
      "class": "Identity",
      "doc": "Identity bound to a running workload via platform attestation (IRSA, WI, pod identity)."
    },
    "ServiceIdentity": {
      "class": "Identity",
      "doc": "Identity a managed service runs as / on behalf of."
    },
    "ApplicationIdentity": {
      "class": "Identity",
      "doc": "Registered app/client with its own credentials & grants (Entra app, OAuth client)."
    },
    "FederatedIdentity": {
      "class": "Identity",
      "doc": "Identity asserted from an external IdP via trust/federation."
    },
    "ExternalIdentity": {
      "class": "Identity",
      "doc": "Principal from another tenant/account/org or third party."
    },
    "AnonymousIdentity": {
      "class": "Identity",
      "doc": "Unauthenticated / public principal (allUsers, *)."
    },
    "Group": {
      "class": "Identity",
      "doc": "Membership container that grants inherited permissions."
    },
    "Role": {
      "class": "Identity",
      "doc": "Assumable/assignable bundle of permissions (distinct from the principal that holds it)."
    },
    "ServiceAccount": {
      "class": "Identity",
      "doc": "GCP-style SA; also a MachineIdentity but modeled distinctly for impersonation semantics."
    },
    "ManagedIdentity": {
      "class": "Identity",
      "doc": "Azure MI (system/user-assigned) bound to resources."
